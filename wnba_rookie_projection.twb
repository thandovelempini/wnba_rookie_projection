    <worksheet name='Disagreements '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#141b2d' fontname='Tableau Bold' fontsize='10'>Biggest disagreements</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Æ&#10;&#10;&#10;&#10;</run>
            <run fontcolor='#5a6472'>✓ the model&apos;s lean was right ・✕ wrong. A slight edge at most, and a pattern: it favours productive bigs  and doubts guards</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Players' name='federated.1tov7ef0a1y3je15hmmro1g4q6js' />
          </datasources>
          <datasource-dependencies datasource='federated.1tov7ef0a1y3je15hmmro1g4q6js'>
            <column caption='Abs Gap' datatype='real' name='[Calculation_1981855941713922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([Model vs Draft Slot])' />
            </column>
            <column caption='Model right?' datatype='string' name='[Calculation_1981855941869571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Model vs Draft Slot] &gt; 0 THEN&#10;       IF [Retained (Season 2 or 3)] THEN &quot;✓&quot; ELSE &quot;✕&quot; END&#10;     ELSE&#10;       IF [Retained (Season 2 or 3)] THEN &quot;✕&quot; ELSE &quot;✓&quot; END&#10;     END' />
            </column>
            <column caption='Player・pick' datatype='string' name='[Calculation_1981855945924612]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Player], &quot; &quot;, -1) + &quot; · &quot; + STR(INT([Pick]))' />
            </column>
            <column caption='Check' datatype='integer' default-format='* &quot;✓&quot;;&quot;✕&quot;' name='[Calculation_1981855946657797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1981855941869571] = &quot;✓&quot; THEN 1 ELSE -1 END' />
            </column>
            <column datatype='real' name='[Model vs Draft Slot]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0%' name='[P(Retained) - Draft Slot]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0%' name='[P(Retained) - Full Model]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' default-format='n0;-0' name='[Pick]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Player]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[Retained (Season 2 or 3)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Split]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1981855941869571]' derivation='None' name='[none:Calculation_1981855941869571:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1981855945924612]' derivation='None' name='[none:Calculation_1981855945924612:nk]' pivot='key' type='nominal' />
            <column-instance column='[Player]' derivation='None' name='[none:Player:nk]' pivot='key' type='nominal' />
            <column-instance column='[Split]' derivation='None' name='[none:Split:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1981855941713922]' derivation='Sum' name='[sum:Calculation_1981855941713922:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1981855946657797]' derivation='Sum' name='[sum:Calculation_1981855946657797:qk]' pivot='key' type='quantitative' />
            <column-instance column='[P(Retained) - Draft Slot]' derivation='Sum' name='[sum:P(Retained) - Draft Slot:qk]' pivot='key' type='quantitative' />
