      <column caption='Watermark Size' datatype='integer' name='[Calculation_2531612912599044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Position Name' datatype='string' name='[Calculation_2531612916396037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Position]&#10;WHEN &quot;G&quot; THEN &quot;Guard&quot;&#10;WHEN &quot;F&quot; THEN &quot;Forward&quot;&#10;WHEN &quot;C&quot; THEN &quot;Center&quot;&#10;WHEN &quot;G-F&quot; THEN &quot;Guard-Forward&quot;&#10;WHEN &quot;F-C&quot; THEN &quot;Forward-Center&quot;&#10;ELSE [Position]&#10;END' />
