    <worksheet name='Star rank'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#141b2d' fontname='Tableau Bold' fontsize='10'>Draft pick vs model rank in class</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#4a5468' fontsize='8'>Size = All-Star selections. Burgundy: model ranked player above their pick・gold: same・grey: below</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Players' name='federated.1tov7ef0a1y3je15hmmro1g4q6js' />
          </datasources>
