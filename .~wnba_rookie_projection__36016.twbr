                  </zone-style>
                </zone>
                <zone fixed-size='36' h='5730' id='51' type-v2='text' w='17424' x='73' y='33205'>
                  <formatted-text>
                    <run fontcolor='#141b2d' fontname='Tableau Bold'>Did it find the stars?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' fixed-size='77' h='11068' id='79' mode='compact' param='[Parameters].[Parameter 1981856626249759]' type-v2='paramctrl' w='17424' x='73' y='38935'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#5a6472' fontsize='8'>FEATURES SHOWN</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' fixed-size='69' h='10026' id='80' mode='list' param='[Parameters].[Parameter 1981856627257376]' type-v2='paramctrl' w='17424' x='73' y='50003'>
                  <formatted-text>
                    <run bold='true' fontcolor='#5a6472' fontsize='8'>DRAFT PICK</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7813' id='88' type-v2='text' w='36164' x='19985' y='82161'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#7b4247' fontname='Tableau Medium' fontsize='8'>At the same pick, players from stronger college teams, better free-throw shooters and stronger rebounders were more likely to stick</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#f2e9e7' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f2e9e7' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7813' id='89' type-v2='text' w='39239' x='58346' y='82161'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#7b4247' fontname='Tableau Medium' fontsize='8'>Scoring efficiency was positively associated with impact. A large final-season jump was associated with lower impact, though this may reflect overlapping features or selection effects</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#f2e9e7' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f2e9e7' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6901' id='87' type-v2='text' w='17424' x='73' y='90107'>
                  <formatted-text>
                    <run bold='true' fontsize='8'>Coefficients from the final models,</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8'>on standardised features. Positive</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8'>= raises retention or impact</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='5209' id='92' type-v2='text' w='82430' x='17570' y='93880'>
                  <formatted-text>
                    <run fontalignment='1' fontname='Tableau Medium' fontsize='8'>How to read: effects are standardised, so they compare within a stage. Features overlap (FT% flips sign between stages), so treat them as patterns, not causes.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{50E9D489-AB2E-4F7E-91F9-AFD9BC119327}' />
    </dashboard>
