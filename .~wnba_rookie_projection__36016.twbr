            <zone custom-title='true' fixed-size='69' h='10026' id='80' is-fixed='true' mode='list' param='[Parameters].[Parameter 1981856627257376]' type-v2='paramctrl' w='17424' x='73' y='50003'>
              <formatted-text>
                <run bold='true' fontcolor='#5a6472' fontsize='8'>DRAFT PICK</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='5' />
                <format attr='padding-top' value='0' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='6901' id='87' type-v2='text' w='17424' x='73' y='90107'>
            <formatted-text>
              <run bold='true' fontsize='8'>Coefficients from the final models,</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>on standardised features. Positive</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='8'>= raises retention or impact</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='padding-left' value='7' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#e5ded3' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
        <zone h='100000' id='6' param='vert' type-v2='layout-flow' w='82430' x='17570' y='0'>
          <zone fixed-size='34' forceUpdate='true' h='5208' id='20' is-fixed='true' type-v2='text' w='82430' x='17570' y='0'>
            <formatted-text>
              <run fontcolor='#7e5a26' fontname='Tableau Bold' fontsize='8'>WHAT DRIVES IT</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='margin-top' value='4' />
              <format attr='margin-bottom' value='2' />
              <format attr='padding-top' value='21' />
              <format attr='padding-left' value='15' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7943' id='21' type-v2='text' w='82430' x='17570' y='5208'>
            <formatted-text>
              <run fontcolor='#141b2d' fontname='Tableau Bold' fontsize='22'>Different stats matter for sticking and for producing</run>
              <run>Æ&#10;</run>
              <run bold='true'>Effects beyong draft slot. Draft pick itself dominates both stages (-1.87 for retention, -1.44 for impact) and is hidden here</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='margin-top' value='0' />
