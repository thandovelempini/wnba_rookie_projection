      <aliases enabled='yes' />
      <column datatype='string' name='[Analysis]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Early-career retention - all picks&quot;' value='Retention · all picks · AUC (higher is better)' />
          <alias key='&quot;Early-career retention - rounds 2-3&quot;' value='Retention · rounds 2–3 · AUC (higher is better)' />
          <alias key='&quot;Impact among retained players&quot;' value='Impact · retained players · RMSE (lower is better)' />
        </aliases>
      </column>
      <column caption='Headline' datatype='boolean' name='[Calculation_1981855964200968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Metric] = &quot;AUC&quot; AND CONTAINS([Analysis], &quot;retention&quot;))&#10;   OR ([Metric] = &quot;RMSE&quot; AND CONTAINS([Analysis], &quot;Impact&quot;))' />
      </column>
      <column caption='Bar Length' datatype='real' name='[Calculation_1981855964368905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Value]) / WINDOW_MAX(SUM([Value]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1981855966855179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Label Position' datatype='real' name='[Calculation_1981856014573580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1.15)' />
      </column>
      <column caption='Is Best' datatype='boolean' name='[Calculation_1981856015425549]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(ATTR([Analysis]), &quot;Impact&quot;)&#10;   THEN SUM([Value]) = WINDOW_MIN(SUM([Value]))&#10;   ELSE SUM([Value]) = WINDOW_MAX(SUM([Value]))&#10;   END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Best Value' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1981856015515662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1981856015425549] THEN SUM([Value]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Other Value' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1981856015646735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT [Calculation_1981856015425549] THEN SUM([Value]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SE Label' datatype='string' name='[Calculation_2475061762809856]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;± &quot; + IF ATTR([Metric]) = &quot;RMSE&quot;&#10;          THEN STR(ROUND(SUM([Std Error]), 2))&#10;          ELSE STR(ROUND(SUM([Std Error]), 3))&#10;          END' />
      </column>
