    <worksheet name='Disagreements '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#141b2d' fontname='Tableau Bold' fontsize='10'>Biggest disagreements</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Æ&#10;&#10;&#10;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#5a6472' fontsize='8'>✓ the model&apos;s lean was right ・✕ wrong. A slight edge at most, and a pattern: it favours productive bigs  and doubts guards</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Players' name='federated.1tov7ef0a1y3je15hmmro1g4q6js' />
          </datasources>
