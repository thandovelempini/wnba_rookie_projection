        <zone forceUpdate='true' h='7813' id='88' type-v2='text' w='36164' x='19985' y='82161'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#7b4247' fontname='Tableau Medium' fontsize='8'>At the same pick, players from stronger college teams, better free-throw shooters and stronger rebounders were more likely to stick</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#f2e9e7' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
            <format attr='margin' value='4' />
            <format attr='padding' value='5' />
            <format attr='background-color' value='#f2e9e7' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='7813' id='89' type-v2='text' w='39239' x='58346' y='82161'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#7b4247' fontname='Tableau Medium' fontsize='8'>Scoring efficiency was positively associated with impact. A large final-season jump was associated with lower impact, though this may reflect overlapping features or selection effects</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#f2e9e7' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='7' />
            <format attr='margin' value='4' />
            <format attr='padding' value='5' />
            <format attr='background-color' value='#f2e9e7' />
          </zone-style>
        </zone>
      </zones>
