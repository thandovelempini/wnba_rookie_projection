      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1tov7ef0a1y3je15hmmro1g4q6js].[sum:Calculation_1981855946657797:qk]&quot;' value=' ' />
          <alias key='&quot;[federated.1tov7ef0a1y3je15hmmro1g4q6js].[sum:P(Retained) - Draft Slot:qk]&quot;' value='Slot' />
          <alias key='&quot;[federated.1tov7ef0a1y3je15hmmro1g4q6js].[sum:P(Retained) - Full Model:qk]&quot;' value='Model' />
        </aliases>
      </column>
      <column aggregation='Sum' datatype='integer' name='[All-Star Selections]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Ast per 40]' role='measure' type='quantitative' />
      <column caption='Diagonal' datatype='real' name='[Calculation_1981855935557632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[P(Retained) - Draft Slot]' />
      </column>
      <column caption='Label' datatype='string' name='[Calculation_1981855937134593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Model vs Draft Slot]) &gt;= 0.15 THEN SPLIT([Player], &quot; &quot;, -1) END' />
      </column>
      <column caption='Abs Gap' datatype='real' name='[Calculation_1981855941713922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Model vs Draft Slot])' />
      </column>
      <column caption='Model right?' datatype='string' name='[Calculation_1981855941869571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Model vs Draft Slot] &gt; 0 THEN&#10;       IF [Retained (Season 2 or 3)] THEN &quot;✓&quot; ELSE &quot;✕&quot; END&#10;     ELSE&#10;       IF [Retained (Season 2 or 3)] THEN &quot;✕&quot; ELSE &quot;✓&quot; END&#10;     END' />
      </column>
      <column caption='Player・pick' datatype='string' name='[Calculation_1981855945924612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Player], &quot; &quot;, -1) + &quot; · &quot; + STR(INT([Pick]))' />
      </column>
      <column caption='Check' datatype='integer' default-format='* &quot;✓&quot;;&quot;✕&quot;' name='[Calculation_1981855946657797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1981855941869571] = &quot;✓&quot; THEN 1 ELSE -1 END' />
      </column>
      <column caption='Model vs Pick' datatype='string' name='[Calculation_1981856025612308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Model Rank in Class] &lt; [Pick] THEN &quot;Model ranked her higher&quot;&#10;   ELSEIF [Model Rank in Class] = [Pick] THEN &quot;Same as pick&quot;&#10;   ELSE &quot;Model ranked her lower&quot; END' />
      </column>
      <column caption='Same Rank' datatype='integer' name='[Calculation_1981856026075157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pick]' />
      </column>
      <column caption='Star Label' datatype='string' name='[Calculation_1981856026320918]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Model Rank in Class] &lt;&gt; [Pick] THEN SPLIT([Player], &quot; &quot;, -1) END' />
      </column>
      <column caption='Above Average' datatype='boolean' name='[Calculation_1981856072237079]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Projected Game Score per 40]) &gt;= 10.1' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1981856074747929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Impact Label Position' datatype='integer' name='[Calculation_1981856078499866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(18)' />
      </column>
      <column caption='Surname' datatype='string' name='[Calculation_1981856080375835]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Player], &quot; &quot;, -1)' />
      </column>
      <column caption='Is Selected' datatype='boolean' name='[Calculation_1981856081850398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Player] = [Parameters].[Parameter 1981856081412125]' />
      </column>
      <column caption='Gauge Value' datatype='real' name='[Calculation_1981856642179106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[P(Retained) - Full Model]' />
      </column>
      <column caption='Gauge Rest' datatype='real' name='[Calculation_1981856642248739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [P(Retained) - Full Model]' />
      </column>
      <column caption='Slot %' datatype='real' name='[Calculation_1981856743718948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([P(Retained) - Draft Slot] * 100)' />
      </column>
      <column caption='Model %' datatype='real' name='[Calculation_1981856743784485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([P(Retained) - Full Model] * 100)' />
      </column>
      <column caption='Gap' datatype='real' default-format='*+0 &quot;PTS&quot;;−0 &quot;PTS&quot;' name='[Calculation_1981856743870502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1981856743784485] - [Calculation_1981856743718948]' />
      </column>
      <column caption='Pick In Draft' datatype='integer' name='[Calculation_1981856789532711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Draft Year] : MAX([Pick]) }' />
      </column>
      <column caption='Round Text' datatype='string' name='[Calculation_1981856790372392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Round]&#10;WHEN 1 THEN &quot;first round&quot;&#10;WHEN 2 THEN &quot;second round&quot;&#10;WHEN 3 THEN &quot;third round&quot;&#10;END' />
      </column>
      <column caption='Outcome Note' datatype='string' name='[Calculation_1981856791015465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Outcome]&#10;WHEN &quot;Retained&quot; THEN &quot;played in season 2 or 3&quot;&#10;WHEN &quot;Not retained&quot; THEN &quot;out of the league by season 3&quot;&#10;ELSE &quot;season 3 not played yet&quot;&#10;END' />
      </column>
      <column caption='Outcome · Retained' datatype='string' name='[Calculation_1981856794648618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Outcome] = &quot;Retained&quot; THEN [Outcome] END' />
      </column>
      <column caption='Outcome · Not retained' datatype='string' name='[Calculation_1981856794824747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Outcome] = &quot;Not retained&quot; THEN [Outcome] END' />
      </column>
      <column caption='Outcome · Too early' datatype='string' name='[Calculation_1981856794931244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Outcome] = &quot;Too early to tell&quot; THEN [Outcome] END' />
      </column>
      <column caption='First Name' datatype='string' name='[Calculation_2531612908908544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Player], &quot; &quot;, 1)' />
      </column>
      <column caption='Last Name' datatype='string' name='[Calculation_2531612909010945]' role='dimension' type='nominal'>
