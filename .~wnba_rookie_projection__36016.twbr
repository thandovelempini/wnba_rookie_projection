          <zone forceUpdate='true' h='5209' id='92' type-v2='text' w='82430' x='17570' y='93880'>
            <formatted-text>
              <run fontalignment='1' fontname='Tableau Medium' fontsize='8'>How to read: effects are standardised, so they compare within a stage. Features overlap (FT% flips sign between stages), so treat them as patterns, not causes.</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
            </formatted-text>
