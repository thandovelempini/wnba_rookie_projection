            <column caption='Model vs Pick' datatype='string' name='[Calculation_1981856025612308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Model Rank in Class] &lt; [Pick] THEN &quot;Model ranked her higher&quot;&#10;   ELSEIF [Model Rank in Class] = [Pick] THEN &quot;Same as pick&quot;&#10;   ELSE &quot;Model ranked her lower&quot; END' />
