            <zone custom-title='true' fixed-size='77' h='11068' id='79' is-fixed='true' mode='compact' param='[Parameters].[Parameter 1981856626249759]' type-v2='paramctrl' w='17424' x='73' y='38935'>
              <formatted-text>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#5a6472' fontsize='8'>FEATURES SHOWN</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
